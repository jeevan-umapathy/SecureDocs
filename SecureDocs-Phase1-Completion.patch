diff --git a/backend/models/folderModel.js b/backend/models/folderModel.js
new file mode 100644
index 0000000..cd24f27
--- /dev/null
+++ b/backend/models/folderModel.js
@@ -0,0 +1,51 @@
+const pool = require("../config/database");
+
+async function list(ownerId) {
+    const result = await pool.query(
+        `SELECT id, parent_id, name, created_at FROM folders
+         WHERE owner_id = $1 ORDER BY lower(name)`,
+        [ownerId]
+    );
+    return result.rows;
+}
+
+async function create(ownerId, name, parentId, client = pool) {
+    const result = await client.query(
+        `INSERT INTO folders (owner_id, name, parent_id)
+         SELECT $1, $2, $3 WHERE $3::bigint IS NULL
+         OR EXISTS (SELECT 1 FROM folders WHERE id = $3 AND owner_id = $1)
+         RETURNING id, parent_id, name, created_at`,
+        [ownerId, name, parentId]
+    );
+    return result.rows[0];
+}
+
+async function rename(ownerId, folderId, name, client = pool) {
+    const result = await client.query(
+        `UPDATE folders SET name = $3 WHERE owner_id = $1 AND id = $2
+         RETURNING id, parent_id, name, created_at`,
+        [ownerId, folderId, name]
+    );
+    return result.rows[0];
+}
+
+async function remove(ownerId, folderId, client = pool) {
+    const result = await client.query(
+        `DELETE FROM folders AS f WHERE f.owner_id = $1 AND f.id = $2
+         AND NOT EXISTS (SELECT 1 FROM files WHERE folder_id = f.id)
+         AND NOT EXISTS (SELECT 1 FROM folders WHERE parent_id = f.id)
+         RETURNING f.id, f.name`,
+        [ownerId, folderId]
+    );
+    return result.rows[0];
+}
+
+async function exists(ownerId, folderId, client = pool) {
+    const result = await client.query(
+        `SELECT 1 FROM folders WHERE id = $1 AND owner_id = $2`,
+        [folderId, ownerId]
+    );
+    return result.rowCount === 1;
+}
+
+module.exports = { list, create, rename, remove, exists };
diff --git a/backend/models/mfaModel.js b/backend/models/mfaModel.js
new file mode 100644
index 0000000..46033f9
--- /dev/null
+++ b/backend/models/mfaModel.js
@@ -0,0 +1,56 @@
+const pool = require("../config/database");
+
+async function findById(id) {
+    const result = await pool.query(
+        `SELECT id, username, email, password_hash, is_active, mfa_enabled,
+                mfa_secret_enc, mfa_pending_enc, mfa_pending_at, mfa_last_step,
+                token_version
+         FROM users WHERE id = $1`,
+        [id]
+    );
+    return result.rows[0];
+}
+
+async function savePending(id, encrypted) {
+    await pool.query(
+        `UPDATE users SET mfa_pending_enc = $2, mfa_pending_at = NOW()
+         WHERE id = $1 AND mfa_enabled = false`,
+        [id, encrypted]
+    );
+}
+
+async function enable(id, encrypted, step, client = pool) {
+    const result = await client.query(
+        `UPDATE users SET mfa_secret_enc = $2, mfa_pending_enc = NULL,
+                mfa_pending_at = NULL, mfa_enabled = true, mfa_last_step = $3,
+                token_version = token_version + 1
+         WHERE id = $1 AND mfa_enabled = false
+           AND mfa_pending_at > NOW() - INTERVAL '10 minutes'
+         RETURNING id`,
+        [id, encrypted, step]
+    );
+    return result.rowCount === 1;
+}
+
+async function claimStep(id, step, client = pool) {
+    const result = await client.query(
+        `UPDATE users SET mfa_last_step = $2
+         WHERE id = $1 AND mfa_enabled = true AND is_active = true
+           AND (mfa_last_step IS NULL OR mfa_last_step < $2)
+         RETURNING id`,
+        [id, step]
+    );
+    return result.rowCount === 1;
+}
+
+async function disable(id, client = pool) {
+    await client.query(
+        `UPDATE users SET mfa_enabled = false, mfa_secret_enc = NULL,
+                mfa_pending_enc = NULL, mfa_pending_at = NULL, mfa_last_step = NULL,
+                token_version = token_version + 1
+         WHERE id = $1`,
+        [id]
+    );
+}
+
+module.exports = { findById, savePending, enable, claimStep, disable };
