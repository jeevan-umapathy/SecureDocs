# PostgreSQL: set these to your existing database, or use DATABASE_URL instead.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=securedocs
DB_USER=postgres
DB_PASSWORD=replace-me
# Optional alternative, takes precedence over DB_*:
# DATABASE_URL=postgresql://user:password@localhost:5432/securedocs
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
