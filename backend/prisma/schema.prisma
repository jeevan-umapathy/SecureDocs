generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_logs {
  id         BigInt   @id @default(autoincrement())
  actor_id   Int?
  action     String
  file_id    Int?
  details    Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users?   @relation(fields: [actor_id], references: [id], onUpdate: NoAction)
  files      files?   @relation(fields: [file_id], references: [id], onUpdate: NoAction)

  @@index([actor_id, created_at(sort: Desc)], map: "audit_logs_actor_time_idx")
  @@index([created_at(sort: Desc)], map: "audit_logs_time_idx")
}

model file_tags {
  id         BigInt    @id @default(autoincrement())
  owner_id   Int
  file_id    Int
  tag_id     BigInt
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  files      files     @relation(fields: [file_id, owner_id], references: [id, owner_id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags       tags      @relation(fields: [tag_id, owner_id], references: [id, owner_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([file_id, tag_id])
}

model files {
  id                                        Int             @id @default(autoincrement())
  owner_id                                  Int
  original_name                             String          @db.VarChar(255)
  stored_name                               String          @db.VarChar(255)
  file_path                                 String
  mime_type                                 String          @db.VarChar(100)
  file_size                                 Int
  uploaded_at                               DateTime?       @default(now()) @db.Timestamp(6)
  folder_id                                 BigInt?
  audit_logs                                audit_logs[]
  file_tags                                 file_tags[]
  folders_files_folder_idTofolders          folders?        @relation("files_folder_idTofolders", fields: [folder_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  folders_files_folder_id_owner_idTofolders folders?        @relation("files_folder_id_owner_idTofolders", fields: [folder_id, owner_id], references: [id, owner_id], onDelete: NoAction, onUpdate: NoAction, map: "files_folder_owner_fk")
  users                                     users           @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notifications                             notifications[]
  shares                                    shares[]

  @@unique([id, owner_id], map: "files_id_owner_unique")
  @@index([owner_id, folder_id], map: "files_folder_idx")
  @@index([owner_id, uploaded_at(sort: Desc)], map: "files_owner_time_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model folders {
  id                                                BigInt    @id @default(autoincrement())
  owner_id                                          Int
  parent_id                                         BigInt?
  name                                              String    @db.VarChar(100)
  created_at                                        DateTime  @default(now()) @db.Timestamptz(6)
  files_files_folder_idTofolders                    files[]   @relation("files_folder_idTofolders")
  files_files_folder_id_owner_idTofolders           files[]   @relation("files_folder_id_owner_idTofolders")
  users                                             users     @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  folders_folders_parent_idTofolders                folders?  @relation("folders_parent_idTofolders", fields: [parent_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  other_folders_folders_parent_idTofolders          folders[] @relation("folders_parent_idTofolders")
  folders_folders_parent_id_owner_idTofolders       folders?  @relation("folders_parent_id_owner_idTofolders", fields: [parent_id, owner_id], references: [id, owner_id], onDelete: NoAction, onUpdate: NoAction, map: "folders_parent_owner_fk")
  other_folders_folders_parent_id_owner_idTofolders folders[] @relation("folders_parent_id_owner_idTofolders")

  @@unique([id, owner_id], map: "folders_id_owner_unique")
  @@index([owner_id, parent_id], map: "folders_parent_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model notifications {
  id           BigInt    @id @default(autoincrement())
  recipient_id Int
  file_id      Int?
  type         String    @db.VarChar(30)
  details      Json      @default("{}")
  is_read      Boolean   @default(false)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  files        files?    @relation(fields: [file_id], references: [id], onUpdate: NoAction)
  users        users     @relation(fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([recipient_id, created_at(sort: Desc)], map: "notifications_recipient_idx")
}

model shares {
  id          Int      @id @default(autoincrement())
  file_id     Int
  shared_with Int
  shared_at   DateTime @default(now()) @db.Timestamptz(6)
  files       files    @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users    @relation(fields: [shared_with], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([file_id, shared_with])
  @@unique([file_id, shared_with], map: "shares_file_recipient_unique")
  @@index([shared_with], map: "shares_recipient_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model tags {
  id         BigInt      @id @default(autoincrement())
  owner_id   Int
  name       String      @db.VarChar(60)
  created_at DateTime?   @default(now()) @db.Timestamptz(6)
  file_tags  file_tags[]
  users      users       @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id, owner_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id              Int             @id @default(autoincrement())
  username        String          @db.VarChar(50)
  email           String          @unique @db.VarChar(255)
  password_hash   String
  totp_secret     String?
  is_admin        Boolean?        @default(false)
  created_at      DateTime?       @default(now()) @db.Timestamp(6)
  updated_at      DateTime?       @default(now()) @db.Timestamp(6)
  role            String          @default("user")
  is_active       Boolean         @default(true)
  mfa_secret_enc  String?
  mfa_pending_enc String?
  mfa_pending_at  DateTime?       @db.Timestamptz(6)
  mfa_enabled     Boolean         @default(false)
  mfa_last_step   BigInt?
  token_version   Int             @default(0)
  audit_logs      audit_logs[]
  file_tags       file_tags[]
  files           files[]
  folders         folders[]
  notifications   notifications[]
  shares          shares[]
  tags            tags[]
}
